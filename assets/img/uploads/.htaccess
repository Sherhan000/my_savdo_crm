# Безопасность: этот каталог хранит только медиафайлы.
# Даже если сюда попадёт .php-файл, сервер не станет его выполнять.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps
<FilesMatch "\.(php|phtml|php\d|phps|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
