# Скопируйте этот файл в .env и заполните своими значениями.

# Логин/пароль первого админ-аккаунта — создаётся один раз при первом запуске
# (когда таблица admin_accounts ещё пустая). После первого входа смените пароль
# в самой админ-панели — эти переменные больше не используются.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change_me_to_a_strong_password

# Groq (https://console.groq.com/keys) — ИИ-подсказки и авто-ответы.
# Без ключа эти функции работают в демо-режиме с заготовленными ответами.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Опционально — если хостинг сайта не может напрямую достучаться до
# api.groq.com (сетевая/региональная блокировка — Groq отдаёт "пустой" 403
# без деталей). Тогда запросы идут через свой Cloudflare Worker-прокси, см.
# backend/config/groq-proxy.js (там же инструкция по деплою). Если оставить
# пустыми — идёт напрямую в Groq, как обычно.
GROQ_PROXY_URL=
GROQ_PROXY_SECRET=

# Установите в 1, только если сайт стоит за доверенным реверс-прокси
# (nginx/Cloudflare), который сам подставляет X-Forwarded-For — иначе
# анти-брутфорс лимиты по IP можно обойти подделкой этого заголовка.
TRUST_PROXY_HEADERS=0

# Resend (https://resend.com) — на будущее, если понадобится отправлять письма
# (например, сброс пароля). Регистрация больше не требует подтверждения почты.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Отправитель писем. onboarding@resend.dev работает без подтверждения домена,
# но с ограничениями — для продакшена подключите свой домен в Resend.
MAIL_FROM="MySavdo <onboarding@resend.dev>"

# Gmail SMTP — отправка 6-значного кода подтверждения почты
# (request-verification.php / verify-email.php). Как получить App Password —
# см. раздел «Настройка подтверждения email» в README.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_SECURE=true

# Публичный адрес сайта.
SITE_URL=http://localhost

# Telegram Login Widget (https://core.telegram.org/widgets/login) — токен бота от @BotFather.
# Домен сайта нужно один раз прописать боту через /setdomain в @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Мост к ig-private-service (Instagram Private API, см. ig-private-service/README.md) ---
# Должен совпадать с CRM_SHARED_SECRET в ig-private-service/.env
IG_PRIVATE_SHARED_SECRET=change_me_to_a_long_random_value
# Адрес, на котором запущен ig-private-service
IG_PRIVATE_SERVICE_URL=http://127.0.0.1:4000
# Должен совпадать с SERVICE_API_KEY в ig-private-service/.env
IG_PRIVATE_API_KEY=change_me_to_a_long_random_value
